{
  "name": "home-budgeting-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Supabase-backed backend for the Home Budgeting mobile app. Migrations + Edge Functions + observability config.",
  "type": "module",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint",
    "functions:serve": "supabase functions serve --env-file ./supabase/functions/.env.local",
    "functions:deploy": "supabase functions deploy",
    "rls:check": "psql \"$SUPABASE_DB_URL\" -f sql/check_rls.sql",
    "test": "deno test --allow-env --allow-net=deno.land,jsr.io supabase/functions/**/*_test.ts"
  },
  "devDependencies": {
    "supabase": "^1.200.0"
  }
}
