# Template for local Edge Function secrets.
# ---------------------------------------------------------------
# 1. Copy this file:   cp .env.local.example .env.local
# 2. Fill in values in .env.local  (never commit .env.local)
# 3. Run:              supabase functions serve --env-file ./supabase/functions/.env.local
#
# Variables injected automatically by the Supabase runtime (do NOT add here):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------

# --- OpenTelemetry (Grafana Cloud) ---
# Leave blank to fall back to stdout (Supabase log pipeline captures it).
# Format: https://<stack>.otlp.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# Format: Authorization=Basic <base64(instanceId:apiToken)>
# Obtain from Grafana Cloud > Connections > OpenTelemetry
OTEL_EXPORTER_OTLP_HEADERS=

OTEL_SERVICE_NAME=home-budgeting-backend
OTEL_SERVICE_VERSION=0.2.0

# --- Sentry (optional crash reporting) ---
# Obtain from https://sentry.io > Settings > Projects > <project> > Client Keys
SENTRY_DSN=
